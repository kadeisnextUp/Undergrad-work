                            .ORIG           x3000
                            LEA             R0, 51
                            TRAP            x20
                            LD              R0,NEWLINE
                            OUT
                            LEA             R0,52
                            PUTS
                            LD              R0, NEWLINE
                            OUT
                            HALT
51                          .STRINGZ "STRING ONE"
52                          .STRINGZ "STRING TWO"
NEWLINE                     .FILL    #13
                            .END
                    
                    